function isArenaReady(arena: string) :: boolean:
    if all:
        yaml value "arenas.%{_arena}%.spawn.x" from "config" is set
        yaml value "arenas.%{_arena}%.spawn.x" from "config" is set
        yaml value "arenas.%{_arena}%.spawn.y" from "config" is set
        yaml value "arenas.%{_arena}%.spawn.z" from "config" is set

        yaml value "arenas.%{_arena}%.arena_center.x" from "config" is set
        yaml value "arenas.%{_arena}%.arena_center.y" from "config" is set
        yaml value "arenas.%{_arena}%.arena_center.z" from "config" is set

        yaml value "arenas.%{_arena}%.arena_boundaries.pos1.x" from "config" is set
        yaml value "arenas.%{_arena}%.arena_boundaries.pos1.y" from "config" is set
        yaml value "arenas.%{_arena}%.arena_boundaries.pos1.z" from "config" is set
        yaml value "arenas.%{_arena}%.arena_boundaries.pos2.x" from "config" is set
        yaml value "arenas.%{_arena}%.arena_boundaries.pos2.y" from "config" is set
        yaml value "arenas.%{_arena}%.arena_boundaries.pos2.z" from "config" is set

        yaml value "arenas.%{_arena}%.lobby_boundaries.pos1.x" from "config" is set
        yaml value "arenas.%{_arena}%.lobby_boundaries.pos1.y" from "config" is set
        yaml value "arenas.%{_arena}%.lobby_boundaries.pos1.z" from "config" is set
        yaml value "arenas.%{_arena}%.lobby_boundaries.pos2.x" from "config" is set
        yaml value "arenas.%{_arena}%.lobby_boundaries.pos2.y" from "config" is set
        yaml value "arenas.%{_arena}%.lobby_boundaries.pos2.z" from "config" is set
    then:
        return true
    else:
        return false



function getArenas() :: strings: 
    loop yaml node keys "arenas" from "config":
        add loop-key to {_arenas::*}
    return {_arenas::*}

function setYamlValue(yaml: string, path: string, value: string):
    set yaml value {_path} from {_yaml} to {_value}

function itemWithCustomNbt(name: string, material: item, tag: string, nbt_value: string) :: item:
    set {_item} to {_material} named {_name}
    set string tag {_tag} of custom nbt of {_item} to {_nbt_value}
    return {_item}

function drawBlockOutline(b: block, steps: number, p: player, particle: visual effect):
    set {_x} to {_b}.getX()
    set {_y} to {_b}.getY()
    set {_z} to {_b}.getZ()
    if {_steps} <= 1:
        set {_steps} to 1
    loop {_steps} times:
        set {_i} to loop-number - 1
        if {_steps} > 1:
            set {_t} to {_i} / ({_steps} - 1)
        else:
            set {_t} to 0
        play {_particle} at location({_x}, {_y} + {_t}, {_z}) to {_p}
        play {_particle} at location({_x} + 1, {_y} + {_t}, {_z}) to {_p}
        play {_particle} at location({_x}, {_y} + {_t}, {_z} + 1) to {_p}
        play {_particle} at location({_x} + 1, {_y} + {_t}, {_z} + 1) to {_p}
        play {_particle} at location({_x} + {_t}, {_y}, {_z}) to {_p}
        play {_particle} at location({_x} + {_t}, {_y}, {_z} + 1) to {_p}
        play {_particle} at location({_x} + {_t}, {_y} + 1, {_z}) to {_p}
        play {_particle} at location({_x} + {_t}, {_y} + 1, {_z} + 1) to {_p}
        play {_particle} at location({_x}, {_y}, {_z} + {_t}) to {_p}
        play {_particle} at location({_x} + 1, {_y}, {_z} + {_t}) to {_p}
        play {_particle} at location({_x}, {_y} + 1, {_z} + {_t}) to {_p}
        play {_particle} at location({_x} + 1, {_y} + 1, {_z} + {_t}) to {_p}